<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!--
      Sensor habits are counted by SensorForegroundService rather than on the JS
      thread, so that walking 10,000 steps counts the steps you take with the app
      closed. That requires a foreground service, and from Android 14 every type the
      service may claim must be declared here as well as at startForeground time.
      The service computes its actual type mask from the permissions it holds; see
      SensorForegroundService.foregroundTypes.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!--
      The Focus Timer's service. There is no foreground-service type for a countdown:
      health/location/microphone would all be lies, and dataSync is capped at six hours
      a day from Android 15, which a long session could reach. specialUse is the
      documented answer, and it is declared with a subtype property on the service.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Doze is the other thing that quietly stops all-day counting: batched sensor
      deliveries stall while the phone is idle, and OEM battery managers will kill the
      service outright. This permission is what lets Rise show the one-tap system
      dialog at first launch instead of sending the user hunting through Settings.
      It is a sensitive permission on Google Play: an app that asks for it must
      genuinely need long-running background work, which continuous step, distance and
      screen-time tracking is. There is a fallback to the Settings list in
      SensorBridge.requestIgnoreBatteryOptimizations if a build refuses the dialog.
    -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <!--
      Digital Sunset measures real evening screen time. PACKAGE_USAGE_STATS has no
      runtime dialog: declaring it is what makes Rise appear in Settings > Special
      app access > Usage access, which SensorBridge.openUsageStatsSettings opens.
      Without the grant the habit degrades to counting unlocks, then to a manual
      check-in, so this is optional rather than load-bearing.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Step hardware is preferred but not required; there is an accelerometer fallback. -->
    <uses-feature
        android:name="android.hardware.sensor.stepcounter"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.accelerometer"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="rise" />
        </intent-filter>
      </activity>
      <receiver
        android:name="com.rise.RiseWidget"
        android:exported="true"
        android:label="@string/widget_tasks_label"
        android:icon="@drawable/widget_icon_tasks">
        <intent-filter>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent-filter>
        <intent-filter>
            <action android:name="com.rise.WIDGET_UPDATE" />
        </intent-filter>
        <intent-filter>
            <action android:name="com.rise.TOGGLE_TASK" />
        </intent-filter>
        <meta-data
            android:name="android.appwidget.provider"
            android:resource="@xml/rise_widget_info" />
      </receiver>

      <receiver
        android:name="com.rise.StepWidget"
        android:exported="true"
        android:label="@string/widget_step_label"
        android:icon="@drawable/widget_icon_steps">
        <intent-filter>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            <action android:name="com.rise.WIDGET_UPDATE" />
        </intent-filter>
        <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_step_info" />
      </receiver>

      <receiver
        android:name="com.rise.DistanceWidget"
        android:exported="true"
        android:label="@string/widget_distance_label"
        android:icon="@drawable/widget_icon_distance">
        <intent-filter>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            <action android:name="com.rise.WIDGET_UPDATE" />
        </intent-filter>
        <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_distance_info" />
      </receiver>

      <receiver
        android:name="com.rise.SilenceWidget"
        android:exported="true"
        android:label="@string/widget_silence_label"
        android:icon="@drawable/widget_icon_silence">
        <intent-filter>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            <action android:name="com.rise.WIDGET_UPDATE" />
        </intent-filter>
        <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_silence_info" />
      </receiver>

      <receiver
        android:name="com.rise.MovementWidget"
        android:exported="true"
        android:label="@string/widget_movement_label"
        android:icon="@drawable/widget_icon_movement">
        <intent-filter>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            <action android:name="com.rise.WIDGET_UPDATE" />
        </intent-filter>
        <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_movement_info" />
      </receiver>

      <receiver
        android:name="com.rise.SunsetWidget"
        android:exported="true"
        android:label="@string/widget_sunset_label"
        android:icon="@drawable/widget_icon_sunset">
        <intent-filter>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            <action android:name="com.rise.WIDGET_UPDATE" />
        </intent-filter>
        <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_sunset_info" />
      </receiver>

      <receiver
        android:name="com.rise.TaskTimerWidget"
        android:exported="true"
        android:label="@string/widget_timer_label"
        android:icon="@drawable/widget_icon_timer">
        <intent-filter>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            <action android:name="com.rise.WIDGET_UPDATE" />
            <action android:name="com.rise.TIMER_ACTION" />
        </intent-filter>
        <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_timer_info" />
      </receiver>

      <receiver
        android:name="com.rise.HabitControlWidget"
        android:exported="true"
        android:label="@string/widget_habits_label"
        android:icon="@drawable/widget_icon_habits">
        <intent-filter>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            <!--
              WIDGET_UPDATE, not the old TOGGLE_HABIT_WIDGET. broadcastUpdate sends
              com.rise.WIDGET_UPDATE, and setPackage still leaves it filter-matched,
              so a receiver without this action never hears a habit change: this
              widget's refresh branch was unreachable and its grid only redrew on
              the host's own schedule. The action it used to declare was never
              constructed by anything.

              com.rise.WIDGET_CONTROL is deliberately absent: the matrix's own
              PendingIntents target this component explicitly, so the action needs no
              filter, and declaring one would only advertise it. What actually keeps a
              forged tap out is the token check in WidgetContract.isTrustedControl.
            -->
            <action android:name="com.rise.WIDGET_UPDATE" />
        </intent-filter>
        <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_habit_info" />
      </receiver>

      <!--
        The wrapper widget. One instance shows one habit chosen by the user, so unlike
        the five sensor providers there is nothing template-shaped about it.

        Only APPWIDGET_UPDATE and WIDGET_UPDATE are filtered. HABIT_TIMER, WIDGET_CONTROL,
        PICK_HABIT and LINK_HABIT are all delivered by PendingIntents that target this
        component explicitly, so they need no filter, and declaring one would only
        advertise them. What keeps a forged tap out is the token check in
        WidgetContract.isTrustedControl, which every branch of onReceive performs.
      -->
      <receiver
        android:name="com.rise.HabitLinkWidget"
        android:exported="true"
        android:label="@string/habit_link_widget_label"
        android:icon="@drawable/widget_icon_habits">
        <intent-filter>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            <action android:name="com.rise.WIDGET_UPDATE" />
        </intent-filter>
        <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_habit_link_info" />
      </receiver>

      <service
        android:name="com.rise.RiseWidgetService"
        android:permission="android.permission.BIND_REMOTEVIEWS"
        android:exported="false" />
      <service
        android:name="com.rise.HabitGridService"
        android:permission="android.permission.BIND_REMOTEVIEWS"
        android:exported="false" />
      <!-- Rows for the wrapper widget's in-widget habit picker. -->
      <service
        android:name="com.rise.HabitPickerService"
        android:permission="android.permission.BIND_REMOTEVIEWS"
        android:exported="false" />

      <!--
        Owns every hardware sensor a habit depends on. foregroundServiceType lists
        every type it may claim; the service narrows this to the types whose
        permissions were actually granted, because Android 14 throws
        SecurityException for a claimed type with a missing permission.
      -->
      <service
        android:name="com.rise.SensorForegroundService"
        android:exported="false"
        android:foregroundServiceType="health|location|microphone|dataSync" />

      <!--
        Rings the Focus Timer on time and moves its ring while the screen is on. Not
        the timer itself: the state is a deadline in SharedPreferences, so the widget
        and the app tab stay correct with this service dead.
      -->
      <service
        android:name="com.rise.FocusTimerService"
        android:exported="false"
        android:foregroundServiceType="specialUse">
        <property
          android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
          android:value="Countdown focus timer started by the user from a home-screen widget or the app; must finish and alert at an exact time with the app closed." />
      </service>

      <receiver
        android:name="com.rise.BootReceiver"
        android:enabled="true"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.BOOT_COMPLETED" />
            <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            <action android:name="android.intent.action.QUICKBOOT_POWERON" />
        </intent-filter>
      </receiver>
    </application>
</manifest>
