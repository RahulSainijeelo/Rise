<?xml version="1.0" encoding="utf-8"?>
<!--
  Control button background for the sensor widgets.

  A hairline border rather than the old solid #1A1A1A block. RemoteViews cannot
  restyle a background per state, so the only signal a button has for "this one is
  active" is its text colour, which the renderer already sets. A filled block
  fights that signal by carrying its own weight; an outlined pill lets the label
  do the talking.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#131313" />
    <corners android:radius="12dp" />
    <stroke android:width="1dp" android:color="#2E2E2E" />
</shape>
