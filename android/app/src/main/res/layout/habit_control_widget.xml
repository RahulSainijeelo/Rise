<?xml version="1.0" encoding="utf-8"?>
<!--
  Rise: Habit Matrix.

  Was a single pinned habit's 35-day heatmap, which is not a matrix — it was one
  habit by days. This is every habit by days: a header that counts today, then one
  scrolling row per habit (habit_matrix_row.xml), each seven columns wide.

  The list is a real collection (setRemoteAdapter + HabitGridService), so it scrolls
  however many habits there are instead of silently showing the first few.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/app_logo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/widget_icon_habits" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/app_logo"
            android:orientation="vertical">

            <TextView
                android:id="@+id/matrix_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="HABIT MATRIX"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/matrix_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="0/0 DONE TODAY"
                android:textColor="#888888"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <TextView
        android:id="@+id/matrix_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="NO HABITS YET\nTAP TO ADD ONE"
        android:textColor="#888888"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <ListView
        android:id="@+id/matrix_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:listSelector="@android:color/transparent" />

</LinearLayout>
