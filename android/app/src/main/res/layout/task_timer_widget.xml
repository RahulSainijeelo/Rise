<?xml version="1.0" encoding="utf-8"?>
<!--
  Rise: Focus Timer.

  Two faces in one layout, swapped with setViewVisibility, because a widget provider
  cannot choose between two layout files without the host discarding the view it
  already inflated.

    focus_setup  the dial. Hours and minutes, two places each, one of them selected;
                 the − and + buttons act on whichever is selected, then START.
    focus_run    the countdown. A drawn ring, a self-ticking Chronometer, pause/play
                 and reset.

  There is not one bare <View> in here, and that is load-bearing rather than tidy:
  RemoteViews inflates through a LayoutInflater.Filter that admits only classes
  carrying the @RemoteView annotation, and android.view.View does not carry it. The
  spacer this file used to have between the two control buttons was enough to throw
  "Class not allowed to be inflated" at apply() time, which the launcher reports as
  "Couldn't add widget". Spacing is done with margins and layout_weight instead.

  The digits are a Chronometer, not a TextView the provider writes: with setBase plus
  setChronometerCountDown the system ticks them down by itself, so a running timer
  needs no per-second RemoteViews push — which the host would throttle anyway, and
  which would cost a wakeup a second.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/focus_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <!-- Header. Tapping it opens the Focus tab in the app. -->
    <LinearLayout
        android:id="@+id/focus_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/focus_label"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="FOCUS"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/focus_today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:singleLine="true"
            android:text=""
            android:textColor="#888888"
            android:textSize="8sp" />

        <ImageView
            android:id="@+id/app_logo"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/widget_icon_timer"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/focus_stage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp">

        <!-- ============================ SETUP ============================ -->
        <LinearLayout
            android:id="@+id/focus_setup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/focus_down"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/widget_button_outline"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/focus_h"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:includeFontPadding="false"
                    android:text="00"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/focus_colon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text=":"
                    android:textColor="#666666"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/focus_m"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:includeFontPadding="false"
                    android:text="25"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/focus_up"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/widget_button_outline"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/focus_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:text="HOURS · MINUTES"
                android:textColor="#666666"
                android:textSize="7sp"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/focus_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/widget_button_background"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="START"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.14" />
        </LinearLayout>

        <!-- =========================== RUNNING =========================== -->
        <LinearLayout
            android:id="@+id/focus_run"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/focus_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center">

                    <Chronometer
                        android:id="@+id/focus_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/focus_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:text="FOCUS"
                        android:textColor="#888888"
                        android:textSize="7sp"
                        android:letterSpacing="0.12" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/focus_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_button_background"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="PAUSE"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/focus_reset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/widget_button_outline"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="RESET"
                    android:textColor="#BBBBBB"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
