<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/habit_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="STEP LEGEND"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
            
        <ImageView
            android:id="@+id/app_logo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/widget_icon_steps" />
    </RelativeLayout>

    <!-- Active State Content -->
    <LinearLayout
        android:id="@+id/habit_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <!-- Main Metric + Visualizer Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="2dp"
            android:paddingEnd="2dp">

            <!-- Sensor Value & Unit -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sensor_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sensor_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STEPS"
                    android:textColor="#AAAAAA"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Animated Theme Visualizer ViewFlipper -->
            <ViewFlipper
                android:id="@+id/habit_anim_flipper"
                android:layout_width="52dp"
                android:layout_height="32dp"
                android:autoStart="true"
                android:flipInterval="800">

                <ImageView
                    android:id="@+id/habit_anim_frame1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/anim_step_frame1" />

                <ImageView
                    android:id="@+id/habit_anim_frame2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/anim_step_frame2" />

                <ImageView
                    android:id="@+id/habit_anim_frame3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/anim_step_frame3" />
            </ViewFlipper>
        </LinearLayout>

        <!-- Progress Bar & Goal Row -->
        <LinearLayout
            android:id="@+id/habit_progress_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp">
            
            <ProgressBar
                android:id="@+id/habit_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:progressDrawable="@drawable/widget_progress_bar" />
                
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp">
                
                <TextView
                    android:id="@+id/habit_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="IN PROGRESS"
                    android:textColor="#D71921"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/habit_goal_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="GOAL: 10000"
                    android:textColor="#666666"
                    android:textSize="8sp" />
            </RelativeLayout>
        </LinearLayout>

        <!-- Interactive Action Controls Row -->
        <LinearLayout
            android:id="@+id/habit_control_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/habit_action_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="✓ COMPLETE NOW"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/widget_item_bg" />
        </LinearLayout>
    </LinearLayout>

    <!-- Empty State Content (Icon + Action Button) -->
    <LinearLayout
        android:id="@+id/habit_empty_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/habit_empty_icon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginBottom="6dp"
            android:src="@drawable/widget_icon_steps" />

        <TextView
            android:id="@+id/habit_empty_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="+ LINK HABIT"
            android:textColor="#D71921"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/widget_login_btn_bg" />
    </LinearLayout>

</LinearLayout>
